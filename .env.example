

# PostgreSQL (Keycloak)
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=ASTRONGPASSWORD

# Keycloak
KEYCLOAK_REALM=VisIVO
KEYCLOAK_CLIENT_ID=visivosg
KEYCLOAK_CLIENT_SECRET=your_client_secret_here
KEYCLOAK_ADMIN=Admin
KEYCLOAK_ADMIN_PASSWORD=Admin_password

# Backend
ENV=production
KEYCLOAK_URL=http://localhost/keycloak
# Frontend
REACT_APP_BACKEND_URL=http://localhost/api
REACT_APP_KEYCLOAK_URL=http://localhost/keycloak 
REACT_APP_KEYCLOAK_REALM=YourRealm
REACT_APP_KEYCLOAK_CLIENT_ID=YourClientID
VITE_SERVER_HOST=0.0.0.0
VITE_SERVER_PORT=5173

#Database 
DB_NAME=app_db
DB_USER=Admin
DB_PASSWORD=your_db_password_here
DB_TYPE=postgresql
DB_HOST=database


# Deployments
CLUSTER_ACCOUNT=your_cluster_account
SSH_KEY_PATH=/app/id_rsa_container
CLUSTER_IP=your_cluster_ip

API_URL=http://localhost
WS_URL=ws://localhost/